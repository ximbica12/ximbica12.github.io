{
  "manifest_version": 2,
  "name": "XLite Helper",
  "version": "0.5.0",
  "description": "Lightweight XLite optimizations for X",
  "browser_specific_settings": {
    "gecko": {
      "id": "xlite-helper@xlite.local",
      "strict_min_version": "121.0"
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://mobile.x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["page.js"],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}