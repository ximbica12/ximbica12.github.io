{
  "manifest_version": 2,
  "name": "YT Lite J7 Shield",
  "version": "0.2.0",
  "description": "Fail-closed YouTube ad shield, H.264 preference, UI cleanup and PT-BR captions for the J7 Prime.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ytlite-j7@ximbica.local",
      "strict_min_version": "115.0"
    },
    "gecko_android": {
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*"
      ],
      "css": ["shield.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
