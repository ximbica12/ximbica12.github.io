{
  "manifest_version": 2,
  "name": "X Lite Optimizer",
  "version": "0.1.0",
  "description": "X.com presentation and performance tweaks for GeckoView.",
  "browser_specific_settings": {
    "gecko": {
      "id": "xlite@ximbica.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
